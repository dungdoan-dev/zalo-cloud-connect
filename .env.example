# OA Access Token V4 được OA cấp quyền gọi thoại.
ZALO_OA_ACCESS_TOKEN=replace_with_your_token

ZALO_APP_ID=4598831758752463028
ZALO_OA_ID=2565558072518292002
ZCC_INBOUND_ID=2565558072518292002101

# Public IP đã khai báo trên Zalo Developer và dải UDP được NAT 1:1 vào máy.
ZALO_PUBLIC_IP=16.176.236.109
ZALO_RTP_MIN_PORT=10000
ZALO_RTP_MAX_PORT=10100

# Tùy chọn nếu máy có nhiều card mạng.
# ZALO_LOCAL_IP=192.168.1.190
# ZALO_OPENAPI_BASE_URL=https://openapi.zalo.me

# direct: engine SIP/RTP POC hien tai; freeswitch: softphone production qua PBX.
CALL_ENGINE=direct

# Cau hinh public gui cho trang /softphone. Khong dat mat khau SIP tai day.
PBX_WSS_URL=wss://pbx.simlydent.vn:7443
PBX_SIP_DOMAIN=pbx.simlydent.vn
# Khi chạy app sau HTTPS/ngrok, Node proxy /sip tới FreeSWITCH để trình duyệt dùng WSS.
# Trên EC2, dùng private IP của FreeSWITCH (không dùng Elastic IP ở đây).
# PBX_WS_UPSTREAM=ws://172.31.13.211:5066
